# ---- copy to .env and change every secret ----
POSTGRES_PASSWORD=change-this-db-password
HTTP_PORT=8080

JWT_SECRET=generate-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_EMAIL=admin@synex.lk
CORS_ORIGINS=https://prices.synex.lk

# QuickBooks Web Connector (runs on the VPS next to QuickBooks Desktop 2024)
QBWC_USERNAME=qbwc
QBWC_PASSWORD=change-this-web-connector-password
# Public HTTPS URL Web Connector will call. Use http://localhost:8080/qbwc only if this app runs on the same VPS.
QBWC_PUBLIC_URL=https://prices.synex.lk/qbwc
# Leave empty to use the company file that is open in QuickBooks, or give the full path, e.g. C:\QB\Synex.qbw
QBWC_COMPANY_FILE=
QBWC_RUN_EVERY_MINUTES=60
QBWC_HISTORY_DAYS=365
QBXML_VERSION=16.0
HOME_CURRENCY=LKR
PRICE_ALERT_THRESHOLD_PCT=5

# Optional e-mail alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=prices@synex.lk
